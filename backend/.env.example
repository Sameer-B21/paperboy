NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=audio

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Must be at least 32 characters
TOKEN_ENCRYPTION_KEY=

# Secret used to sign session tokens (JWTs). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# Gemini API key (Google AI Studio, or a Cloud key with the
# Generative Language API enabled + allowed in its API restrictions)
GEMINI_API_KEY=
# Optional model override; defaults to the latest stable Flash alias
GEMINI_MODEL=gemini-flash-latest

# Google Cloud Text-to-Speech API key
GOOGLE_TTS_API_KEY=

# Optional: default TTS voice (falls back to en-US-Chirp3-HD-Leda)
TTS_VOICE=

# Optional: where to send users after Gmail OAuth completes
FRONTEND_URL=http://localhost:8081

# Optional: shared secret for the host-cron endpoint POST /internal/cron/daily
# (sent as the x-cron-secret header). Leave empty to disable the endpoint.
CRON_SECRET=

# In-process scheduler (delivers each user's digest at their chosen hour).
# Set to "false" in production only if a host cron hits /internal/cron/daily
# HOURLY instead.
ENABLE_SCHEDULER=true

# Optional: days before an episode (and its newsletter text + audio) is purged.
# Defaults to 30. This number is stated in the public privacy policy at
# https://paperboyhq.com/privacy — change one and change the other.
EPISODE_RETENTION_DAYS=30
