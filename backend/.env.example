NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=audio

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Must be at least 32 characters
TOKEN_ENCRYPTION_KEY=

# Secret used to sign session tokens (JWTs). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Cloud Text-to-Speech API key
GOOGLE_TTS_API_KEY=

# Optional: where to send users after Gmail OAuth completes
FRONTEND_URL=http://localhost:8081

# Optional: shared secret for the host-cron endpoint POST /internal/cron/daily
# (sent as the x-cron-secret header). Leave empty to disable the endpoint.
CRON_SECRET=

# In-process 7 AM scheduler. Set to "false" in production if the host's cron
# hits /internal/cron/daily instead.
ENABLE_SCHEDULER=true
